# The edge: the only thing a browser talks to.
#
# It serves the SPA's files itself and proxies everything else to the store — the API, the sign-in
# round trip, the API docs. One origin for all of it, which is what makes the session cookie
# first-party and SameSite=Lax enough, and what lets the SPA call the API without CORS.
#
# The ledger is not reachable from here at all. The store holds the only token that can call it, and
# the browser holds no token of any kind.
#
# A template: the nginx image fills in STORE_UPSTREAM, EDGE_RESOLVER, EDGE_TRUSTED_PROXY and
# EDGE_ACCESS_LOG from the environment when it starts. The Dockerfile's defaults are the compose
# stack's; the AWS task definition sets the service-discovery name, the VPC's resolver and the VPC's
# address range.

# Who the customer is. Behind CloudFront every connection comes from the load balancer, so the
# connection's address is the balancer's — the same for every customer, and useless to a rate limit.
# CloudFront names the viewer in CloudFront-Viewer-Address ("198.51.100.10:46532"), and from here on
# $remote_addr is that address — but only for a connection from EDGE_TRUSTED_PROXY, the range the load
# balancer lives in, which in turn only accepts requests that come through CloudFront. The default,
# `unix:`, is a kind of connection this server never receives: locally nothing is trusted, and a
# client that sends the header itself is ignored. Behind CloudFront a viewer's own is replaced by
# CloudFront's; AWS does not document that, so `scripts/aws.sh smoke` checks it on every deployment.
set_real_ip_from ${EDGE_TRUSTED_PROXY};
real_ip_header CloudFront-Viewer-Address;

# The scheme the viewer used. CloudFront talks to the load balancer over plain HTTP inside AWS, so
# $scheme here says http even when the customer's browser said https — and the store builds the
# sign-in redirect from this, which the identity provider refuses unless it is https. Unlike the
# address, a forged one only misdirects the forger's own sign-in.
map $http_cloudfront_forwarded_proto $forwarded_proto {
  https   https;
  default $scheme;
}

log_format edge escape=json
  '{"time":"$time_iso8601","id":"$request_id","client":"$remote_addr","method":"$request_method","uri":"$request_uri",'
  '"status":$status,"bytes":$body_bytes_sent,"seconds":$request_time,'
  '"upstream_seconds":"$upstream_response_time","cache":"$upstream_cache_status"}';

server_tokens off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json application/problem+json image/svg+xml;

# --- rate limits ---------------------------------------------------------------------------------
# Per client address — the viewer's, not the load balancer's; see above. Reads are generous — a
# browse page is several requests — and writes are not: nobody places five orders a second, and
# something that tries is not a customer.
limit_req_zone $binary_remote_addr zone=reads:10m rate=30r/s;
map $request_method $write_client {
  default "";
  POST    $binary_remote_addr;
  PUT     $binary_remote_addr;
  PATCH   $binary_remote_addr;
  DELETE  $binary_remote_addr;
}
limit_req_zone $write_client zone=writes:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=signin:10m rate=2r/s;
limit_req_status 429;
limit_req_log_level warn;

# --- the catalogue microcache --------------------------------------------------------------------
# The catalogue is the same for everybody, and the store marks it `public, max-age=5` with bounded
# `stale-while-revalidate` and `stale-if-error`. Five seconds is invisible to a customer and, under
# load, turns a thousand identical requests a second for the home page into one every five seconds.
# `proxy_cache_lock` makes concurrent misses wait for the first one rather than all going through.
#
# How stale is the origin's decision, not this file's: `proxy_cache_use_stale updating` would serve
# stale with no upper bound, and a single refetch the cache cannot store is then enough to freeze an
# entry for as long as traffic keeps it warm. Only these read endpoints are cached — never the session
# or orders.
proxy_cache_path /var/cache/nginx/catalogue levels=1:2 keys_zone=catalogue:10m max_size=64m inactive=10m use_temp_path=off;

# Re-resolved as it changes rather than once at start-up: a replaced store container comes back at a
# new address, and an upstream resolved once would go on sending customers to the old one.
resolver ${EDGE_RESOLVER} valid=10s ipv6=off;

upstream store {
  zone store 64k;
  server ${STORE_UPSTREAM} resolve;
  keepalive 32;
}

server {
  # 8080 rather than 80: the image runs nginx as an unprivileged user, which cannot bind below 1024.
  listen 8080;
  listen [::]:8080;
  root /usr/share/nginx/html;

  # Here rather than beside the format: an access_log in this block replaces the image's own, in
  # nginx's `main` format, where one at the top level would be written as well as it — two lines a
  # request, both paid for at CloudWatch's $0.50 a gigabyte. EDGE_ACCESS_LOG is `off` for a load
  # test, whose rate would make the log cost more than the edge.
  access_log ${EDGE_ACCESS_LOG};

  include /etc/nginx/snippets/security-headers.conf;

  # Failures the edge produces itself are problems in the store's shape, so the SPA reads a rate limit
  # or a restarting store the way it reads any other refusal — by its code.
  error_page 429 = @rate_limited;
  error_page 502 503 504 = @store_unavailable;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # --- the SPA ---------------------------------------------------------------------------------
  # Hashed file names: a new build is a new URL, so these can be cached for good.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Every other path is a route the SPA draws. Revalidated on every load, so a deployment is picked
  # up by the next page view rather than whenever a cache decides.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/content-security-policy.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }

  # --- the store -------------------------------------------------------------------------------
  location ~ ^/api/(home|games|genres)(/|$) {
    limit_req zone=reads burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
    proxy_cache catalogue;
    proxy_cache_methods GET HEAD;
    proxy_cache_key $request_uri;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 2s;
    proxy_cache_background_update on;
    # A public response carries no cookie; the store sets none here, and a cookie that somehow got in
    # would otherwise be cached and replayed to every visitor after this one.
    proxy_ignore_headers Set-Cookie;
    proxy_hide_header Set-Cookie;
    # Not X-Cache: CloudFront sets that one itself, for its own cache, over whatever the origin said.
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_pass http://store;
  }

  location /api/ {
    limit_req zone=reads burst=60 nodelay;
    limit_req zone=writes burst=10 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://store;
  }

  # The OpenID Connect round trip: the redirect to the provider, and the callback it sends back.
  location /oauth2/ {
    limit_req zone=signin burst=10 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://store;
  }

  location /login/oauth2/ {
    limit_req zone=signin burst=10 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://store;
  }

  # The published contract and its browser, for whoever is integrating.
  location /v3/api-docs {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://store;
  }

  location /swagger-ui {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://store;
  }

  location @rate_limited {
    include /etc/nginx/snippets/security-headers.conf;
    default_type application/problem+json;
    add_header Retry-After 1 always;
    return 429 '{"type":"about:blank","title":"Too many requests","status":429,"detail":"too many requests from this address; wait a moment and try again","code":"RATE_LIMITED"}';
  }

  location @store_unavailable {
    include /etc/nginx/snippets/security-headers.conf;
    default_type application/problem+json;
    add_header Retry-After 2 always;
    return 503 '{"type":"about:blank","title":"Temporarily unavailable","status":503,"detail":"the store is not answering; your request is safe to retry","code":"STORE_UNAVAILABLE"}';
  }
}

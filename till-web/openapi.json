{
  "components" : {
    "schemas" : {
      "AdjustRequest" : {
        "properties" : {
          "delta" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "delta" ],
        "type" : "object"
      },
      "Committed" : {
        "properties" : {
          "committedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          }
        },
        "required" : [ "committedAt", "id" ],
        "type" : "object"
      },
      "Line" : {
        "properties" : {
          "quantity" : {
            "exclusiveMinimum" : 0,
            "format" : "int64",
            "type" : "integer"
          },
          "sku" : {
            "type" : "string"
          }
        },
        "required" : [ "quantity", "sku" ],
        "type" : "object"
      },
      "OutboxEntry" : {
        "properties" : {
          "dedupeKey" : {
            "type" : "string"
          },
          "payload" : {
            "type" : "string"
          },
          "recordedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "sequence" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "dedupeKey", "payload", "recordedAt", "sequence" ],
        "type" : "object"
      },
      "OutboxPage" : {
        "properties" : {
          "backlog" : {
            "format" : "int64",
            "type" : "integer"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/OutboxEntry"
            },
            "type" : "array"
          }
        },
        "required" : [ "backlog", "items" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "An RFC 9457 problem detail.",
        "properties" : {
          "code" : {
            "enum" : [ "INSUFFICIENT_STOCK", "UNKNOWN_SKU", "RESERVATION_NOT_FOUND", "RESERVATION_EXPIRED", "ALREADY_COMMITTED", "ALREADY_RELEASED", "RESERVATION_ID_IN_USE", "IDEMPOTENCY_KEY_REUSED", "CONTENTION", "UNAUTHORIZED", "FORBIDDEN" ],
            "example" : "INSUFFICIENT_STOCK",
            "type" : "string"
          },
          "detail" : {
            "example" : "widget: asked for 5, 2 available",
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          },
          "requestId" : {
            "example" : "0f9c1a7e-1f3a-4a2b-9a1e-2c4d6e8f0a11",
            "type" : "string"
          },
          "shortfalls" : {
            "items" : {
              "$ref" : "#/components/schemas/Shortfall"
            },
            "type" : "array"
          },
          "status" : {
            "example" : 409,
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "example" : "Not enough stock",
            "type" : "string"
          },
          "type" : {
            "example" : "about:blank",
            "type" : "string"
          }
        },
        "required" : [ "detail", "status", "title" ]
      },
      "Released" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "releasedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "id", "releasedAt" ],
        "type" : "object"
      },
      "Reservation" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "effectiveState" : {
            "enum" : [ "HELD", "COMMITTED", "RELEASED", "EXPIRED" ],
            "type" : "string"
          },
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "lines" : {
            "items" : {
              "$ref" : "#/components/schemas/Line"
            },
            "type" : "array"
          },
          "state" : {
            "enum" : [ "HELD", "COMMITTED", "RELEASED", "EXPIRED" ],
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "effectiveState", "expiresAt", "id", "lines", "state" ],
        "type" : "object"
      },
      "ReservationPage" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Reservation"
            },
            "type" : "array"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "ReserveRequest" : {
        "properties" : {
          "lines" : {
            "items" : {
              "$ref" : "#/components/schemas/Line"
            },
            "minItems" : 1,
            "type" : "array"
          },
          "ttlSeconds" : {
            "description" : "How long the hold lasts. Defaults to till.default-ttl.",
            "example" : 900,
            "exclusiveMinimum" : 0,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "lines" ],
        "type" : "object"
      },
      "Reserved" : {
        "properties" : {
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "lines" : {
            "items" : {
              "$ref" : "#/components/schemas/Line"
            },
            "type" : "array"
          }
        },
        "required" : [ "expiresAt", "id", "lines" ],
        "type" : "object"
      },
      "Shortfall" : {
        "properties" : {
          "available" : {
            "format" : "int64",
            "type" : "integer"
          },
          "requested" : {
            "format" : "int64",
            "type" : "integer"
          },
          "sku" : {
            "type" : "string"
          }
        },
        "required" : [ "available", "requested", "sku" ]
      },
      "Stock" : {
        "properties" : {
          "available" : {
            "format" : "int64",
            "type" : "integer"
          },
          "onHand" : {
            "format" : "int64",
            "type" : "integer"
          },
          "reserved" : {
            "format" : "int64",
            "type" : "integer"
          },
          "sku" : {
            "type" : "string"
          }
        },
        "required" : [ "available", "onHand", "reserved", "sku" ],
        "type" : "object"
      },
      "StockPage" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Stock"
            },
            "type" : "array"
          },
          "nextAfter" : {
            "description" : "Absent on the last page.",
            "type" : "string"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "description" : "till.auth.client-token for everything, till.auth.admin-token for changing stock levels",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "An oversell-proof inventory reservation service. Every mutating endpoint requires an Idempotency-Key header; sending the same key twice returns the first answer and changes nothing.",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/licenses/MIT"
    },
    "title" : "till",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/v1/outbox" : {
      "get" : {
        "operationId" : "listOutbox",
        "parameters" : [ {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 50,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OutboxPage"
                }
              }
            },
            "description" : "the backlog and its oldest entries"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "the request could not be read, or a value in it was not valid"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "no bearer token, or one this service does not know"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "this needs the admin token"
          }
        },
        "summary" : "The unpublished tail of the outbox",
        "tags" : [ "outbox-controller" ]
      }
    },
    "/v1/reservations" : {
      "get" : {
        "operationId" : "listReservations",
        "parameters" : [ {
          "in" : "query",
          "name" : "state",
          "required" : false,
          "schema" : {
            "enum" : [ "HELD", "COMMITTED", "RELEASED", "EXPIRED" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 100,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReservationPage"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "the request could not be read, or a value in it was not valid"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "no bearer token, or one this service does not know"
          }
        },
        "summary" : "List reservations, newest first",
        "tags" : [ "reservation-controller" ]
      },
      "post" : {
        "operationId" : "reserve",
        "parameters" : [ {
          "description" : "Retrying with this key returns the first answer and changes nothing",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Reserved"
                }
              }
            },
            "description" : "the hold was taken, or already existed under this key"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "the request could not be read, or a value in it was not valid"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "no bearer token, or one this service does not know"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "a SKU has never been stocked"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "not enough available stock; the body lists every shortfall"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "this key was used for a different request"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "too much contention; retry"
          }
        },
        "summary" : "Take a hold on stock",
        "tags" : [ "reservation-controller" ]
      }
    },
    "/v1/reservations/{id}" : {
      "get" : {
        "operationId" : "getReservation",

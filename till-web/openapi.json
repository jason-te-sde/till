                }
              }
            },
            "description" : "on-hand and reserved both went down"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "the request could not be read, or a value in it was not valid"

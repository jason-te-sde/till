<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kafka's clients log their whole resolved configuration at INFO every time a producer or consumer
  is constructed. In a suite that builds several, that is hundreds of lines between the test name
  and its failure. Warnings and errors still come through.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="org.testcontainers" level="WARN"/>
  <logger name="com.github.dockerjava" level="WARN"/>
  <logger name="tc" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
